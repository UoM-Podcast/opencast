# Ignore file for Opencast Matterhorn project
#

# ignore maven target directories
target/
target-grunt/
node_modules/
node/
/build/
/data/

# ignore Eclipse project data
.project
.classpath
.metadata/
.settings/
.recommenders/

# ignore NetBeans project data
*/nbproject/*
*/nb-configuration.xml

# ingore OS artifacts
.DS_Store

# Ignore all temporary editor files
*.swp
*.iml
.idea
.sonarlint

# Ignore Maven files and local repository
/.m2/
/settings.xml

# Ignore mkdocs sites
docs/guides/*/site

# Ignore Makefiles
# Sometimes they help, but they should never be tracked
Makefile
/modules/matterhorn-admin-ui-ng/bower_components/
/modules/matterhorn-edit-ui-ng/bower_components/

# Ignore OS artifacts
.DS_Store

# Ignore phantomjs logs
phantomjsdriver.log

# Manchester specific

# Ignore Manchester workflows and encodings
/etc/workflows/Manchester-*
/etc/encoding/Manchester-*
