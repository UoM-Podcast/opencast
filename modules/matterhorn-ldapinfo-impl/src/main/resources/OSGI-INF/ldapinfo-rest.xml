<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.ldapinfo.impl.endpoint.LdapInfoRestEndpoint"
               immediate="true">
  <implementation class="org.opencastproject.ldapinfo.impl.endpoint.LdapInfoRestEndpoint" />
  <property name="service.description" value="LDAP Information REST Endpoint" />
  <property name="opencast.service.type" value="org.opencastproject.ldapinfo" />
  <property name="opencast.service.path" value="/ldapinfo" />
  <property name="opencast.service.jobproducer" value="false" />
  <service>
    <provide interface="org.opencastproject.ldapinfo.impl.endpoint.LdapInfoRestEndpoint" />
  </service>
  <reference name="ldapinfo-service" 
             interface="org.opencastproject.ldapinfo.api.LdapInfoService"
             cardinality="1..1" 
             policy="static" 
             bind="setLdapInfoService" />
</scr:component>