<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.comments.persistence.CommentDatabaseImpl"
               immediate="true"
               activate="activate">
  <implementation class="org.opencastproject.comments.persistence.CommentDatabaseImpl" />
  <property name="service.description" value="Comment Persistence Service" />
  <service>
    <provide interface="org.opencastproject.comments.persistence.CommentDatabase" />
  </service>
  <reference name="entityManagerFactory"
             interface="javax.persistence.EntityManagerFactory"
             target="(osgi.unit.name=org.opencastproject.comments)"
             cardinality="1..1"
             policy="static"
             bind="setEntityManagerFactory" />
</scr:component>
