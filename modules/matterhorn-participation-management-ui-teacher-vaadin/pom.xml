<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>matterhorn-participation-management-ui-teacher-vaadin</artifactId>
  <name>matterhorn-participation-management-ui-teacher-vaadin</name>
  <packaging>bundle</packaging>
  <parent>
    <groupId>org.opencastproject</groupId>
    <artifactId>base</artifactId>
    <version>3.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <properties>
    <matterhorn.basedir>${project.basedir}/../..</matterhorn.basedir>
    <checkstyle.skip>false</checkstyle.skip>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
            <Build-Number>${buildNumber}</Build-Number>
            <!-- add all application packages here -->
            <Import-Package>
              org.opencastproject.pm.ui.common.components;version="${project.version}",
              org.opencastproject.pm.ui.common.util;version="${project.version}",
              org.opencastproject.pm.ui.teacher;version="${project.version}",
              org.opencastproject.pm.ui.teacher.vaadin;version="${project.version}",
              VAADIN.themes.PM;version="${project.version}",
              VAADIN.themes.PM.img;version="${project.version}",
              javax.servlet;version="3.1.0",
              com.vaadin.server;version="[7.0.3,7.1.0)"
            </Import-Package>
            <Fragment-Host>com.vaadin.server</Fragment-Host>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>