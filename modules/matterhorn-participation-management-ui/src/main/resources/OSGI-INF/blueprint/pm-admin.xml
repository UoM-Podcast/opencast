<?xml version="1.0" encoding="UTF-8"?>
<blueprint default-activation="eager" xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0">
  <!-- Vaadin servlet running the HQ UI -->
  <service interface="javax.servlet.Servlet">
    <service-properties>
      <entry key="servlet-name" value="Opencast Participation Management Admin UI" />
      <entry key="alias" value="/pm-admin" />
      <entry key="contextId" value="matterhorn-participation-management-ui" />
      <entry key="init.UIProvider" value="org.opencastproject.pm.ui.admin.vaadin.PmAdminUiProvider" />
    </service-properties>
    <bean class="com.vaadin.server.VaadinServlet" />
  </service>
</blueprint>