<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.pm.ui.admin.PmDependencies"
               immediate="true"
               activate="activate">
  <implementation class="org.opencastproject.pm.ui.admin.PmDependencies" />
  <service>
    <provide interface="org.opencastproject.pm.ui.admin.PmDependencies" />
  </service>
  <property name="service.description" value="PM dependencies" />
  <reference interface="org.opencastproject.pm.api.persistence.ParticipationManagementDatabase"
             name="participationManagementDatabase"
             cardinality="0..1"
             policy="dynamic"
             bind="setParticipationManagementDatabase"
             unbind="unsetParticipationManagementDatabase" />
  <reference interface="org.opencastproject.pm.api.scheduling.ParticipationFeederService"
             name="participationFeederService"
             cardinality="0..1"
             policy="dynamic"
             bind="setParticipationFeederService"
             unbind="unsetParticipationFeederService" />
  <reference interface="org.opencastproject.pm.api.scheduling.ScheduleFeederService"
             name="scheduleFeederService"
             cardinality="0..1"
             policy="dynamic"
             bind="setScheduleFeederService"
             unbind="unsetScheduleFeederService" />
  <reference interface="org.opencastproject.pm.api.scheduling.SnapCountService"
             name="snapCountService"
             cardinality="0..1"
             policy="dynamic"
             bind="setSnapCountService"
             unbind="unsetSnapCountService" />
  <reference interface="org.opencastproject.pm.api.EmailSender"
             name="emailSenderService"
             cardinality="0..1"
             policy="dynamic"
             bind="setEmailSenderService"
             unbind="unsetEmailSenderService" />
  <reference interface="org.opencastproject.security.api.SecurityService"
             name="security"
             cardinality="1..1"
             policy="static"
             bind="setSecurityService"/>
</scr:component>
