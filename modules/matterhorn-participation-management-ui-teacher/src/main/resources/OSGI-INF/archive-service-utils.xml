<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.pm.ui.teacher.ArchiveServiceUtils"
               immediate="true">
  <implementation class="org.opencastproject.pm.ui.teacher.ArchiveServiceUtils" />
  <property name="service.description" value="Archive Remote Read-Only Service Proxy" />

  <service>
    <provide interface="org.opencastproject.pm.ui.teacher.ArchiveServiceUtils" />
  </service>

  <reference name="trustedHttpClient"
             interface="org.opencastproject.security.api.TrustedHttpClient"
             cardinality="1..1"
             policy="static"
             bind="setTrustedHttpClient" />
  <reference name="remoteServiceManager"
             interface="org.opencastproject.serviceregistry.api.ServiceRegistry"
             cardinality="1..1"
             policy="static"
             bind="setRemoteServiceManager" />
</scr:component>
