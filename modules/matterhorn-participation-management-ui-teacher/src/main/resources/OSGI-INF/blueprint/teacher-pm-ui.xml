<?xml version="1.0" encoding="UTF-8"?>
<blueprint default-activation="eager" xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0">
  <!-- Vaadin servlet running the HQ UI -->
  <service interface="javax.servlet.Servlet">
    <service-properties>
      <entry key="servlet-name" value="Teacher Participation Management UI" />
      <entry key="alias" value="/pm-teacher" />
      <entry key="httpContext.id" value="opencast.httpcontext"/>
      <entry key="httpContext.shared" value="true" />
      <entry key="init.UIProvider" value="org.opencastproject.pm.ui.teacher.vaadin.TeacherPmUiProvider" />
    </service-properties>
    <bean class="org.opencastproject.vaadin.ConfiguredVaadinServlet" />
  </service>
</blueprint>