<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.archive.aws.glacier.AwsGlacierCacheCleaner"
               activate="activate" deactivate="deactivate"
               immediate="true">

  <implementation class="org.opencastproject.archive.aws.glacier.AwsGlacierCacheCleaner" />
  <property name="service.description" value="AWS Glacier cache cleaner" />

  <service>
    <provide interface="org.osgi.service.cm.ManagedService" />
  </service>

  <reference cardinality="1..1" interface="org.opencastproject.archive.aws.glacier.AwsGlacierAssetStore"
             name="elementStore"
             policy="static"
             bind="setAssetStore"/>
  <reference cardinality="1..1" interface="org.opencastproject.security.api.OrganizationDirectoryService"
             name="OrganizationDirectoryService"
             policy="static"
             bind="bindOrganizationDirectoryService"/>
  <reference cardinality="1..1" interface="org.opencastproject.security.api.SecurityService"
             name="SecurityService"
             policy="static"
             bind="bindSecurityService"/>
</scr:component>

