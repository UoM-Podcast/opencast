<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.pm.syllabus.remote.SyllabusDataService"
               immediate="true"
               activate="activate">
  <implementation class="org.opencastproject.pm.syllabus.remote.SyllabusDataServiceRemote" />
  <property name="service.pid" value="org.opencastproject.pm.syllabus.remote.SyllabusDataService" />
  <property name="service.description" value="Syllabus+ data harvester" />
  <service>
    <provide interface="org.osgi.service.cm.ManagedService" />
    <!-- FIXME: interface="org.opencastproject.pm.syllabus.api.SyllabusDataService" -->
    <provide interface="org.opencastproject.pm.syllabus.remote.SyllabusDataServiceRemote" />
  </service>
  <reference name="syllabus"
             interface="org.opencastproject.pm.syllabus.api.SyllabusService"
             cardinality="1..1"
             policy="static"
             bind="setSyllabusService" />
    <reference name="trustedHttpClient"
             interface="org.opencastproject.security.api.TrustedHttpClient"
             cardinality="1..1"
             policy="static"
             bind="setTrustedHttpClient" />
</scr:component>